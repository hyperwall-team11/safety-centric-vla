<mujoco model="diff_drive_robot">
  <!-- 바퀴 두 개(좌·우 구동) + 앞뒤 보조바퀴의 차동 구동 모바일 로봇 -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>
  <asset>
    <texture name="floor_texture" type="2d" builtin="checker"
             rgb1="0.65 0.65 0.65" rgb2="0.45 0.45 0.45" width="256" height="256"/>
    <material name="floor_material" texture="floor_texture" texrepeat="4 4"/>
  </asset>

  <worldbody>
    <light pos="0 -2 6" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_material"/>
    <camera name="cctv_1" pos="0 -6 5" xyaxes="1 0 0 0 0.64 0.768" fovy="55"/>

    <body name="base_link" pos="0 0 0.06">
      <freejoint name="base_joint"/>
      <geom name="chassis" type="box" size="0.2 0.15 0.04" mass="5" rgba="0.2 0.5 0.8 1"/>
      <!-- 앞쪽(+x) 표시 -->
      <geom name="heading_marker" type="box" pos="0.16 0 0.045" size="0.03 0.05 0.005"
            rgba="1 1 1 1" contype="0" conaffinity="0" mass="0"/>

      <body name="left_wheel" pos="0 0.175 -0.01">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.05 0.02" euler="1.5708 0 0"
              mass="0.5" rgba="0.1 0.1 0.1 1" friction="1.5 0.005 0.0001"/>
      </body>
      <body name="right_wheel" pos="0 -0.175 -0.01">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.05 0.02" euler="1.5708 0 0"
              mass="0.5" rgba="0.1 0.1 0.1 1" friction="1.5 0.005 0.0001"/>
      </body>

      <!-- 보조바퀴: 마찰 없는 구 (priority로 바닥 마찰 대신 이 값을 사용) -->
      <geom name="caster_front" type="sphere" size="0.02" pos="0.15 0 -0.04"
            condim="1" priority="1" mass="0.1" rgba="0.6 0.6 0.6 1"/>
      <geom name="caster_back" type="sphere" size="0.02" pos="-0.15 0 -0.04"
            condim="1" priority="1" mass="0.1" rgba="0.6 0.6 0.6 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- 바퀴 각속도(rad/s) 명령 -->
    <velocity name="left_wheel_motor" joint="left_wheel_joint" kv="5" ctrlrange="-30 30"/>
    <velocity name="right_wheel_motor" joint="right_wheel_joint" kv="5" ctrlrange="-30 30"/>
  </actuator>
</mujoco>
