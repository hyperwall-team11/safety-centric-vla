BACKEND_STORE=redis
BACKEND_REDIS_URL=redis://127.0.0.1:6379/0
BACKEND_REDIS_KEY=safety-centric-vla:state:v1
BACKEND_CLOSED_LOOP_ENABLED=0
BACKEND_CLOSED_LOOP_POLL_INTERVAL_SECONDS=0.5
BACKEND_CLOSED_LOOP_MAX_ATTEMPTS_PER_STEP=3
BACKEND_CLOSED_LOOP_RESULT_TIMEOUT_SECONDS=120
# rule-based(기본) 또는 openai. 실제 키는 .env.local 같은 gitignore 파일에만 저장한다.
BACKEND_ACTION_PLANNER=rule-based
OPENAI_ACTION_MODEL=gpt-4o-mini
OPENAI_ACTION_TIMEOUT_SECONDS=30
