<mujoco model="oasis_camera_demo">
  <compiler angle="degree"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>
  <asset>
    <texture name="floor_texture" type="2d" builtin="checker"
             rgb1="0.65 0.65 0.65" rgb2="0.45 0.45 0.45" width="256" height="256"/>
    <material name="floor_material" texture="floor_texture" texrepeat="4 4"/>
  </asset>
  <worldbody>
    <light pos="0 -2 6" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_material"/>
    <!-- Red marking only: this does not enforce a safety rule. -->
    <geom name="keep_out_marking" type="box" pos="0 0 0.006"
          size="1.2 1.2 0.005" rgba="0.9 0.1 0.1 0.45" contype="0" conaffinity="0"/>
    <camera name="cctv_1" pos="0 -6 5" xyaxes="1 0 0 0 0.64 0.768" fovy="55"/>
    <!-- A deliberately simple mannequin, not a realistic human asset. -->
    <body name="worker" mocap="true" pos="2 0 0">
      <geom name="torso" type="capsule" fromto="0 0 0.85 0 0 1.35" size="0.18" rgba="1 0.65 0.05 1"/>
      <geom name="head" type="sphere" pos="0 0 1.65" size="0.15" rgba="0.85 0.65 0.5 1"/>
      <geom name="left_leg" type="capsule" fromto="-0.12 0 0.15 -0.12 0 0.8" size="0.07" rgba="0.1 0.2 0.6 1"/>
      <geom name="right_leg" type="capsule" fromto="0.12 0 0.15 0.12 0 0.8" size="0.07" rgba="0.1 0.2 0.6 1"/>
      <geom name="left_arm" type="capsule" fromto="-0.23 0 1.35 -0.35 0 0.9" size="0.06" rgba="1 0.65 0.05 1"/>
      <geom name="right_arm" type="capsule" fromto="0.23 0 1.35 0.35 0 0.9" size="0.06" rgba="1 0.65 0.05 1"/>
    </body>
  </worldbody>
</mujoco>
